# Intervalo de verificação em segundos
CHECK_INTERVAL=60

# Banco de dados
DATABASE_URL=sqlite:///ofertas.db

# WhatsApp (evolution-api — https://github.com/EvolutionAPI/evolution-api)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_chave
EVOLUTION_INSTANCE=minha-instancia
WHATSAPP_GROUP_ID=120363xxxxxx@g.us

# Reenvio quando o preço cai (%)
REENVIO_QUEDA_MINIMA=15

# Mercado Livre agora exige um app registrado para buscar (client_credentials).
# Crie em https://developers.mercadolivre.com.br/ — sem isso essa fonte é pulada.
MERCADOLIVRE_APP_ID=
MERCADOLIVRE_APP_SECRET=
LOMADEE_SOURCE_ID=

# Shopee Afiliados — Open API
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# Mercado Livre Afiliados (createLink)
MERCADOLIVRE_AFFILIATE_TAG=
MERCADOLIVRE_AFFILIATE_COOKIE=

# OpenAI opcional (ranking/copy) — use gpt-4o-mini pra render os créditos
OPENAI_API_KEY=

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
